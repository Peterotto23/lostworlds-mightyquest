/*
    Persistent inventory implementation.
*/

#include "../Stdinclude.hpp"

namespace Backend
{
    namespace Inventory
    {
        struct InventoryItem_t
        {
            std::string ObjectID;
            int Slot = -1;
            MQEL_json Item = MQEL_json::object();

            MQEL_json Serialize()
            {
                MQEL_json Object =
                    MQEL_json::object();

                Object["ObjectId"] =
                    ObjectID;

                Object["Slot"] =
                    Slot;

                Object["Item"] =
                    Item;

                return Object;
            }

            void Deserialize(MQEL_json &Object)
            {
                if (!Object["ObjectId"].is_null() &&
                    Object["ObjectId"].is_string())
                {
                    ObjectID =
                        Object["ObjectId"].get<std::string>();
                }

                if (!Object["Slot"].is_null())
                    Slot =
                        Object["Slot"].get<int>();

                if (!Object["Item"].is_null())
                    Item =
                        Object["Item"];
            }
        };

        std::vector<InventoryItem_t> Items;
        std::vector<InventoryItem_t> Inbox;

        int FindFreeSlot()
        {
            int Slot = 0;

            while (true)
            {
                bool Occupied = false;

                for (auto &Item : Items)
                {
                    if (Item.Slot == Slot)
                    {
                        Occupied = true;
                        break;
                    }
                }

                if (!Occupied)
                    return Slot;

                ++Slot;
            }
        }

        void Save()
        {
            MQEL_json Object =
                MQEL_json::object();

            Object["Inventory"] =
                MQEL_json::array();

            for (auto &Item : Items)
                Object["Inventory"] +=
                    Item.Serialize();

            Object["Inbox"] =
                MQEL_json::array();

            for (auto &Item : Inbox)
                Object["Inbox"] +=
                    Item.Serialize();

            Infoprint(
                va(
                    "Inventory Save: writing %u inventory items, %u inbox items.",
                    (unsigned)Items.size(),
                    (unsigned)Inbox.size()));

            std::string Plaintext =
                Object.dump(4);

            Infoprint(
                va(
                    "Inventory Save: serialized JSON length=%u.",
                    (unsigned)Plaintext.size()));

            Package::Write(
                "Inventory.json",
                Plaintext);

            Infoprint(
                "Inventory Save: Package::Write completed.");
        }

        void Load()
        {
            Items.clear();
            Inbox.clear();

            auto Filebuffer =
                Package::Read("Inventory.json");

            if (Filebuffer.empty())
            {
                Infoprint(
                    "Inventory Load: Inventory.json is empty or missing.");
                return;
            }

            try
            {
                auto Object =
                    MQEL_json::parse(Filebuffer);

                if (!Object["Inventory"].is_null() &&
                    Object["Inventory"].is_array())
                {
                    for (auto &Entry :
                         Object["Inventory"])
                    {
                        InventoryItem_t Item;

                        Item.Deserialize(
                            Entry);

                        if (Item.ObjectID.empty())
                        {
                            Infoprint(
                                "Inventory Load: skipping inventory item without ObjectId.");
                            continue;
                        }

                        Items.push_back(
                            Item);
                    }
                }

                if (!Object["Inbox"].is_null() &&
                    Object["Inbox"].is_array())
                {
                    for (auto &Entry :
                         Object["Inbox"])
                    {
                        InventoryItem_t Item;

                        Item.Deserialize(
                            Entry);

                        if (Item.ObjectID.empty())
                        {
                            Infoprint(
                                "Inventory Load: skipping inbox item without ObjectId.");
                            continue;
                        }

                        Inbox.push_back(
                            Item);
                    }
                }

                Infoprint(
                    va(
                        "Inventory loaded: %u inventory items, %u inbox items.",
                        (unsigned)Items.size(),
                        (unsigned)Inbox.size()));

                for (auto &Item : Items)
                {
                    Infoprint(
                        va(
                            "Inventory Load: item ObjectId=%s Slot=%i JSON=%s",
                            Item.ObjectID.c_str(),
                            Item.Slot,
                            Item.Item.dump().c_str()));
                }
            }
            catch (std::exception &e)
            {
                Infoprint(
                    va(
                        "Inventory load failed: %s",
                        e.what()));
            }
        }

        void Addinbox(MQEL_json Item)
        {
            std::string ObjectID;

            if (!Item["ObjectId"].is_null() &&
                Item["ObjectId"].is_string())
            {
                ObjectID =
                    Item["ObjectId"].get<std::string>();
            }

            if (ObjectID.empty())
            {
                Infoprint(
                    "Inventory: refusing inbox item without ObjectId.");
                return;
            }

            for (auto &Existing : Inbox)
            {
                if (Existing.ObjectID == ObjectID)
                {
                    Infoprint(
                        va(
                            "Inventory: inbox item %s already exists.",
                            ObjectID.c_str()));
                    return;
                }
            }

            InventoryItem_t NewItem;

            NewItem.ObjectID =
                ObjectID;

            NewItem.Item =
                Item;

            NewItem.Slot =
                -1;

            Inbox.push_back(
                NewItem);

            Save();

            Infoprint(
                va(
                    "Inventory: stored inbox item %s.",
                    ObjectID.c_str()));
        }

        void Addreward(MQEL_json Reward)
        {
            std::string ObjectID;

            if (!Reward["ObjectId"].is_null() &&
                Reward["ObjectId"].is_string())
            {
                ObjectID =
                    Reward["ObjectId"].get<std::string>();
            }

            if (ObjectID.empty())
            {
                Infoprint(
                    "Inventory: refusing reward without ObjectId.");
                return;
            }

            for (auto &Existing : Items)
            {
                if (Existing.ObjectID == ObjectID)
                {
                    Infoprint(
                        va(
                            "Inventory: reward %s already exists.",
                            ObjectID.c_str()));
                    return;
                }
            }

            MQEL_json HeroItem =
                Reward;

            if (!Reward["HeroItem"].is_null() &&
                Reward["HeroItem"].is_object())
            {
                HeroItem =
                    Reward["HeroItem"];
            }

            if (!HeroItem.is_object())
            {
                Infoprint(
                    va(
                        "Inventory: reward %s has invalid item JSON.",
                        ObjectID.c_str()));
                return;
            }

            int Slot =
                FindFreeSlot();

            InventoryItem_t NewItem;

            NewItem.ObjectID =
                ObjectID;

            NewItem.Slot =
                Slot;

            NewItem.Item =
                HeroItem;

            Items.push_back(
                NewItem);

            Save();

            Infoprint(
                va(
                    "Inventory: persisted attack reward %s in slot %i.",
                    ObjectID.c_str(),
                    Slot));

            Infoprint(
                va(
                    "Inventory: persisted reward JSON = %s.",
                    HeroItem.dump().c_str()));
        }

        bool Collect(
            std::string ObjectID,
            int Slot)
        {
            if (Slot < 0)
                Slot =
                    FindFreeSlot();

            else
            {
                for (auto &Existing : Items)
                {
                    if (Existing.Slot == Slot)
                    {
                        Infoprint(
                            va(
                                "Inventory: collect destination slot %i is occupied.",
                                Slot));

                        return false;
                    }
                }
            }

            for (auto Iterator = Inbox.begin();
                 Iterator != Inbox.end();
                 ++Iterator)
            {
                if (Iterator->ObjectID != ObjectID)
                    continue;

                InventoryItem_t Item =
                    *Iterator;

                MQEL_json InventoryItem =
                    Item.Item;

                if (InventoryItem["HeroItem"].is_object())
                {
                    InventoryItem =
                        InventoryItem["HeroItem"];
                }

                if (Item.Item["$type"].is_string())
                {
                    const std::string InboxType =
                        Item.Item["$type"].get<std::string>();

                    if (InboxType.find(
                            "InboxHeroEquipmentItem") !=
                        std::string::npos)
                    {
                        InventoryItem["$type"] =
                            "HyperQuest.GameServer.Contracts.HeroEquipmentItem, HyperQuest.GameServer.Contracts";

                        InventoryItem["Type"] =
                            "HeroEquipmentItem";
                    }
                    else if (InboxType.find(
                                 "InboxHeroConsumableItem") !=
                             std::string::npos)
                    {
                        InventoryItem["$type"] =
                            "HyperQuest.GameServer.Contracts.HeroConsumableItem, HyperQuest.GameServer.Contracts";
                    }
                }

                InventoryItem["ObjectId"] =
                    Item.ObjectID;

                Item.Item =
                    InventoryItem;

                Item.Slot =
                    Slot;

                Infoprint(
                    va(
                        "Inventory: collecting %s into slot %i.",
                        Item.ObjectID.c_str(),
                        Slot));

                Infoprint(
                    va(
                        "Inventory: converted inbox item to inventory payload: %s",
                        Item.Item.dump().c_str()));

                Inbox.erase(
                    Iterator);

                Items.push_back(
                    Item);

                Save();

                Infoprint(
                    va(
                        "Inventory: collected %s into inventory slot %i.",
                        Item.ObjectID.c_str(),
                        Slot));

                return true;
            }

            Infoprint(
                va(
                    "Inventory: could not find inbox item %s.",
                    ObjectID.c_str()));

            return false;
        }

        void Addpurchased(
            MQEL_json Item,
            int Slot)
        {
            std::string ObjectID;

            /*
                Purchased items normally arrive with ObjectId.
                Accept a few alternate spellings as a safeguard.
            */
            if (!Item["ObjectId"].is_null() &&
                Item["ObjectId"].is_string())
            {
                ObjectID =
                    Item["ObjectId"].get<std::string>();
            }
            else if (!Item["ObjectID"].is_null() &&
                     Item["ObjectID"].is_string())
            {
                ObjectID =
                    Item["ObjectID"].get<std::string>();
            }

            /*
                The purchase command must never silently discard an item.
                Log the complete payload when no ObjectId was supplied.
            */
            if (ObjectID.empty())
            {
                Infoprint(
                    va(
                        "Inventory: purchased item has no ObjectId. JSON=%s",
                        Item.dump().c_str()));

                return;
            }

            for (auto &Existing : Items)
            {
                if (Existing.ObjectID == ObjectID)
                {
                    Infoprint(
                        va(
                            "Inventory: purchased item %s already exists.",
                            ObjectID.c_str()));

                    return;
                }
            }

            /*
                Do not trust an invalid or already occupied client slot.
            */
            if (Slot < 0)
            {
                Slot =
                    FindFreeSlot();
            }
            else
            {
                bool Occupied = false;

                for (auto &Existing : Items)
                {
                    if (Existing.Slot == Slot)
                    {
                        Occupied = true;
                        break;
                    }
                }

                if (Occupied)
                {
                    Infoprint(
                        va(
                            "Inventory: purchase slot %i is occupied; assigning a free slot.",
                            Slot));

                    Slot =
                        FindFreeSlot();
                }
            }

            /*
                Make absolutely sure the persistent item itself carries
                its ObjectId. That way a reload does not depend on the
                outer InventoryItem_t wrapper alone.
            */
            Item["ObjectId"] =
                ObjectID;

            Item["SlotIndex"] =
                Slot;

            InventoryItem_t NewItem;

            NewItem.ObjectID =
                ObjectID;

            NewItem.Item =
                Item;

            NewItem.Slot =
                Slot;

            Items.push_back(
                NewItem);

            Infoprint(
                va(
                    "Inventory: storing purchased item %s in slot %i.",
                    ObjectID.c_str(),
                    Slot));

            Infoprint(
                va(
                    "Inventory: purchased item JSON=%s",
                    Item.dump().c_str()));

            Save();

            /*
                Verify the item is still present in the in-memory
                persistent collection immediately after Save().
            */
            bool FoundAfterSave = false;

            for (auto &Existing : Items)
            {
                if (Existing.ObjectID == ObjectID &&
                    Existing.Slot == Slot)
                {
                    FoundAfterSave = true;
                    break;
                }
            }

            Infoprint(
                va(
                    "Inventory: purchased item %s save verification=%s.",
                    ObjectID.c_str(),
                    FoundAfterSave ? "OK" : "FAILED"));
        }

        bool Swap(
            int SourceSlot,
            int DestinationSlot)
        {
            InventoryItem_t *Source =
                nullptr;

            InventoryItem_t *Destination =
                nullptr;

            for (auto &Item : Items)
            {
                if (Item.Slot == SourceSlot)
                    Source = &Item;

                if (Item.Slot == DestinationSlot)
                    Destination = &Item;
            }

            if (!Source)
                return false;

            if (Destination)
            {
                std::swap(
                    Source->Slot,
                    Destination->Slot);
            }
            else
            {
                Source->Slot =
                    DestinationSlot;
            }

            Save();

            Infoprint(
                va(
                    "Inventory: moved item %s from slot %i to slot %i.",
                    Source->ObjectID.c_str(),
                    SourceSlot,
                    DestinationSlot));

            return true;
        }

        bool Equip(
            int SourceSlot,
            int DestinationSlot,
            int HeroID)
        {
            for (auto Iterator = Items.begin();
                 Iterator != Items.end();
                 ++Iterator)
            {
                if (Iterator->Slot != SourceSlot)
                    continue;

                Infoprint(
                    va(
                        "Inventory: found item %s in slot %i.",
                        Iterator->ObjectID.c_str(),
                        SourceSlot));

                Infoprint(
                    va(
                        "Inventory: Item JSON type = %s.",
                        Iterator->Item.type_name()));

                Infoprint(
                    va(
                        "Inventory: Item JSON = %s.",
                        Iterator->Item.dump().c_str()));

                if (!Iterator->Item.is_object())
                {
                    Infoprint(
                        "Inventory: ERROR - stored item is not a JSON object.");

                    return false;
                }

                Equipment_t Equipment{};

                try
                {
                    Infoprint(
                        "Inventory: starting Equipment.Deserialize().");

                    Equipment.Deserialize(
                        Iterator->Item);

                    Infoprint(
                        va(
                            "Inventory: Equipment.Deserialize() OK. TemplateId=%u ArchetypeId=%u.",
                            Equipment.ID,
                            Equipment.Archetype));
                }
                catch (std::exception &e)
                {
                    Infoprint(
                        va(
                            "Inventory: Equipment.Deserialize() FAILED: %s",
                            e.what()));

                    return false;
                }

                Infoprint(
                    va(
                        "Inventory: equipping item %s from inventory slot %i to hero %i equipment slot %i.",
                        Iterator->ObjectID.c_str(),
                        SourceSlot,
                        HeroID,
                        DestinationSlot));

                try
                {
                    Backend::Hero::Equipgear(
                        (eItemslot)DestinationSlot,
                        Equipment,
                        (eHerotype)HeroID);

                    Infoprint(
                        "Inventory: Hero::Equipgear() OK.");
                }
                catch (std::exception &e)
                {
                    Infoprint(
                        va(
                            "Inventory: Hero::Equipgear() FAILED: %s",
                            e.what()));

                    return false;
                }

                Items.erase(
                    Iterator);

                Save();

                Infoprint(
                    va(
                        "Inventory: equipped item and removed it from inventory slot %i.",
                        SourceSlot));

                return true;
            }

            Infoprint(
                va(
                    "Inventory: could not find item in inventory slot %i to equip.",
                    SourceSlot));

            return false;
        }

        bool Unequip(
            int HeroID,
            int EquipmentSlot)
        {
            (void)HeroID;
            (void)EquipmentSlot;

            /*
                Equipment synchronization will be added later.
            */

            return false;
        }

        MQEL_json Serialize()
        {
            MQEL_json Result =
                MQEL_json::array();

            for (auto &Item : Items)
            {
                MQEL_json Object =
                    Item.Item;

                Object["ObjectId"] =
                    Item.ObjectID;

                Object["SlotIndex"] =
                    Item.Slot;

                Result +=
                    Object;
            }

            return Result;
        }

        MQEL_json Serializeinbox()
        {
            MQEL_json Result =
                MQEL_json::array();

            for (auto &Item : Inbox)
            {
                MQEL_json Object =
                    Item.Item;

                Object["ObjectId"] =
                    Item.ObjectID;

                Result +=
                    Object;
            }

            return Result;
        }
    }
